# App
APP_NAME="OneSpace Scheduling Service"
# Service version, reported by GET /health and the OpenAPI metadata.
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# Server
# Bind host for the API. Reserved — server_run.py currently binds 0.0.0.0
# regardless; this lets config and .env stay in sync.
HOST=0.0.0.0
# Bind port for the API (read by server_run.py / docker-compose). Default 3011.
PORT=3011
# Granian worker processes. Scale up for higher concurrency.
WORKERS=1

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=onespace_scheduler_scheduling

# Scheduler
SCHEDULER_JOBS_COLLECTION=onespace_scheduler_jobs
SCHEDULER_TIMEZONE=UTC

# Webhook actions
# Allow webhook targets on loopback/private IPs. Keep false in prod (SSRF guard);
# set true in dev/test to hit a local listener.
WEBHOOK_ALLOW_PRIVATE_HOSTS=false
# Max chars of a webhook response body kept in each run record.
WEBHOOK_RESPONSE_MAX_CHARS=2048
# Timeout (seconds) for the best-effort notify callback.
NOTIFY_TIMEOUT_SECONDS=10
# Days to keep run history (TTL). 0 = keep forever.
RUN_HISTORY_TTL_DAYS=0

# Health
# Per-probe timeout (seconds) for GET /health. Keep it well below the timeouts
# sized for real calls — a probe that hangs is a probe nobody polls.
HEALTH_PROBE_TIMEOUT_S=3

# Built MkDocs site, served by the app at /documentation. Run `mkdocs build`
# to create it; if the directory is absent the route is not mounted.
DOCS_SITE_DIR=site
